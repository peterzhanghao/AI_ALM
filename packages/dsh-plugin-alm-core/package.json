{
  "name": "@ai-alm/dsh-plugin-alm-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ALM core Host service and probe tools (ALM-01.02 host capability spike)",
  "exports": {
    ".": "./index.js",
    "./consumer": "./consumer.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "consumer.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}

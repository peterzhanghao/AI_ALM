{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alm.asset/v1",
  "title": "ALM Asset",
  "type": "object",
  "required": ["schema_version", "id", "type", "title", "status", "owner", "links"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^(REQ|ADR|MOD|IF|DM|TEST|RISK)-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "enum": [
        "requirement",
        "architecture-decision",
        "module",
        "interface",
        "data-model",
        "acceptance-test",
        "risk"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "accepted", "deprecated", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": [
              "satisfies",
              "allocated_to",
              "depends_on",
              "constrained_by",
              "verified_by",
              "supersedes"
            ]
          },
          "target": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": ["path", "format", "line"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["yaml", "sdoc", "markdown", "openapi"] },
        "line": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "extra": { "type": "object" }
  },
  "additionalProperties": true
}

{
  "name": "ai-alm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "alm": "node packages/alm-core/bin/alm.mjs",
    "test": "node --test \"packages/*/test/**/*.test.mjs\"",
    "test:ui": "node scripts/ui-verify.mjs",
    "serve:pages": "node scripts/serve-alm-pages.mjs",
    "drill": "node scripts/drill.mjs",
    "ci": "node --test \"packages/*/test/**/*.test.mjs\" && node packages/alm-core/bin/alm.mjs contract verify",
    "sync:tasks": "node scripts/sync-tasks.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}

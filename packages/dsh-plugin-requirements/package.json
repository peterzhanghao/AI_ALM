{
  "name": "@ai-alm/dsh-plugin-requirements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./host.bundle.js",
  "description": "Requirements domain page and read-only tools for the AI Native ALM MVP",
  "exports": {
    ".": "./host.bundle.js",
    "./query": "./query.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "build:host": "node build-host.mjs"
  },
  "files": [
    "host.bundle.js",
    "build-host.mjs",
    "index.js",
    "query.mjs",
    "client.js",
    "client-source.js",
    "client.bundle.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
